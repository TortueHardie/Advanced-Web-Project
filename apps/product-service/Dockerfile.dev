FROM node:20.11.0 as development

# Create app directory
WORKDIR /usr/src/app

# Copy package files first for better caching
COPY package*.json ./
COPY packages/prisma/package*.json ./packages/prisma/
COPY apps/product-service/package*.json ./apps/product-service/

# Copy essential files
COPY tsconfig*.json ./
COPY turbo.json ./
COPY ./packages/prisma/ ./packages/prisma/

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy only the product service
COPY ./apps/product-service/ ./apps/product-service/

# Generate Prisma client
RUN npx prisma generate --schema=./packages/prisma/prisma/schema.prisma

# Make sure the application listens on the correct host
RUN sed -i 's/await app\.listen(3002)/await app\.listen(3002, "0.0.0.0")/' ./apps/product-service/src/main.ts

# Create directory for PrismaService if not exists
RUN mkdir -p /usr/src/app/apps/product-service/src/prisma

# Create a symbolic link for the PrismaService
RUN ln -sf /usr/src/app/packages/prisma/src/prisma.service.ts /usr/src/app/apps/product-service/src/prisma/prisma.service.ts
RUN ln -sf /usr/src/app/packages/prisma/src/index.ts /usr/src/app/apps/product-service/src/prisma/index.ts

# Change to product-service directory
WORKDIR /usr/src/app/apps/product-service

# Expose ports
EXPOSE 3002
EXPOSE 4002

# Run the service in development mode
CMD ["npx", "ts-node-dev", "--respawn", "--transpile-only", "src/main.ts"] 