FROM node:20-slim

WORKDIR /usr/src/app

# Installation des dépendances système nécessaires
RUN apt-get update && \
    apt-get install -y build-essential python3 && \
    rm -rf /var/lib/apt/lists/*

# Copie des fichiers de configuration
COPY package*.json ./
COPY packages/prisma/package*.json ./packages/prisma/

# Installation des dépendances
RUN npm install --legacy-peer-deps

# Installation des dépendances globales nécessaires
RUN npm install -g @nestjs/cli

# Copie des fichiers source
COPY packages/prisma ./packages/prisma
COPY apps/delivery-service ./apps/delivery-service
COPY tsconfig.json ./
COPY turbo.json ./

# Génération du client Prisma
RUN npx prisma generate --schema=./packages/prisma/prisma/schema.prisma

# Compilation du code TypeScript
RUN cd apps/delivery-service && npm install && npx nest build

EXPOSE 3003

CMD ["sh", "-c", "cd apps/delivery-service && npx ts-node src/main.ts"]