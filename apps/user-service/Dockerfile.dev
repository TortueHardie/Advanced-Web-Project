FROM node:20.11.0 as development

# Create app directory
WORKDIR /usr/src/app

# Installer NestJS CLI globalement
RUN npm install -g @nestjs/cli

# Copy root package files and install dependencies
COPY package*.json ./
COPY tsconfig*.json ./
RUN npm install

# Copy prisma package and schema
COPY ./packages/ ./packages/

# Generate Prisma client
RUN npx prisma generate --schema=./packages/prisma/prisma/schema.prisma

# Copy user-service
COPY ./apps/user-service ./apps/user-service

# Create directory for PrismaService
RUN mkdir -p /usr/src/app/apps/user-service/src/prisma

# Create a modified version of the PrismaService
RUN echo 'import { Injectable, OnModuleInit, OnModuleDestroy } from "@nestjs/common";\n\
import { PrismaClient } from "@prisma/client";\n\
\n\
@Injectable()\n\
export class PrismaService extends PrismaClient implements OnModuleInit, OnModuleDestroy {\n\
  async onModuleInit() {\n\
    await this.$connect();\n\
  }\n\
\n\
  async onModuleDestroy() {\n\
    await this.$disconnect();\n\
  }\n\
}' > /usr/src/app/apps/user-service/src/prisma/prisma.service.ts

# Create an index file to export the service
RUN echo 'export * from "./prisma.service";' > /usr/src/app/apps/user-service/src/prisma/index.ts

# Create a modified version of the repository that directly uses PrismaClient
RUN echo 'import { Injectable } from "@nestjs/common";\n\
import { PrismaClient } from "@prisma/client";\n\
import { User, Prisma } from "@prisma/client";\n\
\n\
@Injectable()\n\
export class UserRepository {\n\
  private prisma: PrismaClient;\n\
\n\
  constructor() {\n\
    this.prisma = new PrismaClient();\n\
  }\n\
\n\
  async create(data: Prisma.UserCreateInput): Promise<User> {\n\
    return this.prisma.user.create({\n\
      data,\n\
    });\n\
  }\n\
\n\
  async findAll(): Promise<User[]> {\n\
    return this.prisma.user.findMany();\n\
  }\n\
\n\
  async findOne(id: number): Promise<User | null> {\n\
    return this.prisma.user.findUnique({\n\
      where: { id },\n\
    });\n\
  }\n\
\n\
  async findByEmail(email: string): Promise<User | null> {\n\
    return this.prisma.user.findUnique({\n\
      where: { email },\n\
    });\n\
  }\n\
\n\
  async update(id: number, data: Prisma.UserUpdateInput): Promise<User> {\n\
    return this.prisma.user.update({\n\
      where: { id },\n\
      data,\n\
    });\n\
  }\n\
\n\
  async remove(id: number): Promise<User> {\n\
    return this.prisma.user.delete({\n\
      where: { id },\n\
    });\n\
  }\n\
\n\
  async updateLastLogin(id: string | number): Promise<User> {\n\
    const numericId = typeof id === "string" ? parseInt(id, 10) : id;\n\
    return this.prisma.user.update({\n\
      where: { id: numericId },\n\
      data: {},\n\
    });\n\
  }\n\
}' > /usr/src/app/apps/user-service/src/repositories/user.repository.ts

# Create a simplified app.module.ts file
RUN echo 'import { Module } from "@nestjs/common";\n\
import { UserController } from "./controllers/user.controller";\n\
import { UserService } from "./services/user.service";\n\
import { UserRepository } from "./repositories/user.repository";\n\
\n\
@Module({\n\
  imports: [],\n\
  controllers: [UserController],\n\
  providers: [UserService, UserRepository],\n\
})\n\
export class AppModule {}' > /usr/src/app/apps/user-service/src/app.module.ts

# Change working directory to user-service
WORKDIR /usr/src/app/apps/user-service

# Run the service
CMD ["npm", "run", "start:dev"] 