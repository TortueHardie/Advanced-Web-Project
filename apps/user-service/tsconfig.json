{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@advanced-web/prisma": ["../../../packages/prisma/src"],
      "@advanced-web/prisma/*": ["../../../packages/prisma/src/*"],
      "@advanced-web/common": ["../../../packages/common/src"],
      "@advanced-web/common/*": ["../../../packages/common/src/*"],
      "@advanced-web/database": ["../../../packages/database/src"],
      "@advanced-web/database/*": ["../../../packages/database/src/*"]
    }
  }
}
